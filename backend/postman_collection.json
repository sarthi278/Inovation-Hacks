{
  "info": {
    "name": "Innovation Hacks REST API",
    "description": "Postman Collection for Developer Productivity & AI Task Management Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
      }
    },
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Anubhav Yadav\",\n  \"email\": \"anubhav@innovationhacks.in\",\n  \"password\": \"password123\",\n  \"role\": \"developer\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"anubhav@innovationhacks.in\",\n  \"password\": \"password123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "Projects - Get All",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
      }
    },
    {
      "name": "Projects - Create",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Mobile App v2\",\n  \"description\": \"React Native cross-platform build\",\n  \"color\": \"purple\",\n  \"collaborators\": 3\n}"
        },
        "url": { "raw": "{{baseUrl}}/projects", "host": ["{{baseUrl}}"], "path": ["projects"] }
      }
    },
    {
      "name": "Tasks - Get All (with Filter)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/tasks?status=todo&priority=High",
          "host": ["{{baseUrl}}"],
          "path": ["tasks"],
          "query": [
            { "key": "status", "value": "todo" },
            { "key": "priority", "value": "High" }
          ]
        }
      }
    },
    {
      "name": "Tasks - Get Dashboard Stats",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/tasks/stats/summary", "host": ["{{baseUrl}}"], "path": ["tasks", "stats", "summary"] }
      }
    },
    {
      "name": "Tasks - Create Task",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Implement OAuth2 Google Login\",\n  \"project\": \"Atlas design system\",\n  \"priority\": \"High\",\n  \"tag\": \"Engineering\",\n  \"due\": \"Today\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
      }
    },
    {
      "name": "AI - Generate Subtasks",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Build full-stack AI project manager\",\n  \"project\": \"Atlas design system\",\n  \"autoInsert\": false\n}"
        },
        "url": { "raw": "{{baseUrl}}/ai/generate-tasks", "host": ["{{baseUrl}}"], "path": ["ai", "generate-tasks"] }
      }
    },
    {
      "name": "AI - Workload Summary & Recommendations",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/ai/summarize", "host": ["{{baseUrl}}"], "path": ["ai", "summarize"] }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ]
}
